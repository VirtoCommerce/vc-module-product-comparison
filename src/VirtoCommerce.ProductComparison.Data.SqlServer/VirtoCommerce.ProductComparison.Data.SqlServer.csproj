<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Transitive override: this project resolves System.Security.Cryptography.Pkcs 9.0.11 transitively, which is vulnerable -->
    <!-- (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Remove once the packages that bring it reference a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="VirtoCommerce.Platform.Data.SqlServer" Version="3.1078.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.ProductComparison.Data\VirtoCommerce.ProductComparison.Data.csproj" />
  </ItemGroup>
</Project>
