<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <!-- Must match the module's EF Core (10.0.12), or the build warns MSB3277. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <!-- Storefront E2E only: the browser that drives the real storefront. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- The platform and the modules the harnesses host, as each registers itself, on SQLite and a RAM Lucene index
         (Infrastructure/PlatformModules*.cs), at the versions X-Cart.Core 3.1042.0 and X-Catalog.Core 3.1023.0 depend
         on; plus the storefront shell's for the storefront E2E (StorefrontE2E/Infrastructure/StorefrontShellModules.cs:
         X-Profile, X-Frontend at 3.1008.0, the last one on platform 3.1078, SEO, X-CMS with the content module,
         X-Recommend). Platform.Modules: the platform's optional dependencies and AppManifestService. -->
    <PackageReference Include="VirtoCommerce.AssetsModule.Data" Version="3.1010.0" />
    <PackageReference Include="VirtoCommerce.CartModule.Data" Version="3.1012.0" />
    <PackageReference Include="VirtoCommerce.CatalogModule.Data" Version="3.1048.0" />
    <PackageReference Include="VirtoCommerce.ContentModule.Data" Version="3.1008.0" />
    <PackageReference Include="VirtoCommerce.ContentModule.FileSystem" Version="3.1008.0" />
    <PackageReference Include="VirtoCommerce.CoreModule.Data" Version="3.1012.0" />
    <PackageReference Include="VirtoCommerce.CustomerModule.Data" Version="3.1028.0" />
    <PackageReference Include="VirtoCommerce.FileExperienceApi.Data" Version="3.1008.0" />
    <PackageReference Include="VirtoCommerce.FileSystemAssetsModule.Core" Version="3.1006.0" />
    <PackageReference Include="VirtoCommerce.InventoryModule.Data" Version="3.1010.0" />
    <PackageReference Include="VirtoCommerce.LuceneSearchModule.Data" Version="3.1002.0" />
    <PackageReference Include="VirtoCommerce.MarketingModule.Data" Version="3.1009.0" />
    <PackageReference Include="VirtoCommerce.PaymentModule.Data" Version="3.1010.0" />
    <PackageReference Include="VirtoCommerce.Platform.Modules" Version="3.1078.0" />
    <PackageReference Include="VirtoCommerce.PricingModule.Data" Version="3.1008.0" />
    <PackageReference Include="VirtoCommerce.ProfileExperienceApiModule.Data" Version="3.1020.0" />
    <PackageReference Include="VirtoCommerce.SearchModule.Data" Version="3.1010.2" />
    <PackageReference Include="VirtoCommerce.Seo.Data" Version="3.1005.0" />
    <PackageReference Include="VirtoCommerce.ShippingModule.Data" Version="3.1009.0" />
    <PackageReference Include="VirtoCommerce.StoreModule.Data" Version="3.1009.0" />
    <PackageReference Include="VirtoCommerce.Xapi.Data" Version="3.1027.0" />
    <PackageReference Include="VirtoCommerce.XCart.Data" Version="3.1042.0" />
    <PackageReference Include="VirtoCommerce.XCatalog.Data" Version="3.1023.0" />
    <PackageReference Include="VirtoCommerce.XCMS.Data" Version="3.1009.0" />
    <PackageReference Include="VirtoCommerce.XFrontend.Data" Version="3.1008.0" />
    <PackageReference Include="VirtoCommerce.XRecommend.Data" Version="3.1002.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The platform's country lists, which it ships in its own content root (Platform.Web), not on NuGet. -->
    <None Update="Platform\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Storefront E2E only: Kestrel, which hosts the harness for the real storefront. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtoCommerce.ProductComparison.Core\VirtoCommerce.ProductComparison.Core.csproj" />
    <ProjectReference Include="..\..\src\VirtoCommerce.ProductComparison.Data\VirtoCommerce.ProductComparison.Data.csproj" />
    <ProjectReference Include="..\..\src\VirtoCommerce.ProductComparison.Xapi\VirtoCommerce.ProductComparison.Xapi.csproj" />
    <ProjectReference Include="..\..\src\VirtoCommerce.ProductComparison.Web\VirtoCommerce.ProductComparison.Web.csproj" />
  </ItemGroup>
</Project>
